# Railway Postgres connection string (Railway injects this automatically
# when the web service and the Postgres service share a project; copy it
# from the Postgres service's "Connect" tab otherwise). Use the owning
# role's string for db:migrate/db:seed; use the least-privileged
# `app_user` role's string (see db/create_app_role.sql) for the running app.
DATABASE_URL=

NEXT_PUBLIC_APP_URL=http://localhost:3000

# Password reset AND notification emails (§13). Without this set, both
# are logged to the server console instead of emailed -- fine for local
# dev, required in production.
RESEND_API_KEY=
EMAIL_FROM="Compliance Platform <no-reply@example.com>"

# Railway bucket (S3-compatible) credentials for document storage (§16).
RAILWAY_BUCKET_ENDPOINT=
RAILWAY_BUCKET_NAME=
RAILWAY_BUCKET_ACCESS_KEY_ID=
RAILWAY_BUCKET_SECRET_ACCESS_KEY=
RAILWAY_BUCKET_REGION=auto

# The nightly notification check (POST /api/cron/notify) needs to read
# every organization, which the app's own least-privileged DATABASE_URL
# (once db/create_app_role.sql's app_user role is in use) can't do under
# RLS. Point this at a connection that bypasses RLS -- omit it and it
# falls back to DATABASE_URL, which is fine while that's still the
# unrestricted owner connection in local dev.
JOB_DATABASE_URL=
# Shared secret the scheduler (Railway cron trigger or similar) sends as
# `Authorization: Bearer <value>` when calling /api/cron/notify. Required --
# the endpoint refuses every request until this is set.
CRON_SECRET=

# Additive / future phases -- not required yet
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
